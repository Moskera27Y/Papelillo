# ============================================================
# VARIABLES DE ENTORNO — PAPELILLO
# ============================================================
# Copia este archivo como ".env.local" y rellena con tus valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# ---------- GENERAL ----------
# URL pública del sitio (usada para webhooks de Wompi y metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- BASE DE DATOS (Neon Postgres) ----------
# Connection string "pooled" (para la app, usada por Prisma Client en runtime)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
# Connection string directa/"unpooled" (para migraciones: prisma db push / migrate)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# ---------- WOMPI (Pasarela de pagos Colombia) ----------
# Documentación: https://docs.wompi.co/

# Llave pública (se puede usar en frontend)
# Obtener en: https://comercios.wompi.co (prod) o https://sandbox.comercios.wompi.co
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave privada (solo server-side, NUNCA en frontend)
# Se usa para firmar transacciones vía API
WOMPI_PRIVATE_KEY=priv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave de integridad (solo server-side, NUNCA en frontend)
# Se usa para generar la firma del monto (signature.integrity)
WOMPI_INTEGRITY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de eventos (solo server-side)
# Se usa para validar webhooks de Wompi (HMAC-SHA256)
WOMPI_EVENTS_SECRET=evt_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Ambiente de Wompi ("sandbox" o "production")
# El admin también permite cambiarlo desde la UI, pero esta variable
# define el valor inicial cuando el admin no lo ha configurado aún.
NEXT_PUBLIC_WOMPI_ENVIRONMENT=sandbox

# ---------- AUTH ADMIN ----------
# Credenciales iniciales del administrador.
# Una vez iniciada la aplicación, se pueden cambiar desde /admin/settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=papelillo2026

# ---------- CONTACTO (valores iniciales, editables desde admin) ----------
# Se pueden cambiar desde el panel admin en /admin/contact
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
